{% extends 'base.html.twig' %}

{% block title %}
	{{ 'password_reset.check_email.title' | trans }}
{% endblock %}

{% block body %}
<div class="mx-auto max-w-360 px-10 mb-20">
        <div class="mx-auto max-w-122 flex flex-col gap-6">
            <p>
                {{ 'password_reset.check_email.description' | trans }}
            </p>
            <p>
                {{ 'password_reset.check_email.timeToLive' | trans({ '%ttl%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }) }}
            </p>
            <p>
                {{ 'password_reset.check_email.checkSpam' | trans({ '%address%': mailerAddress }) }}
            </p>
    </div>
</div>
{% endblock %}
