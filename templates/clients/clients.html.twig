{% extends 'base.html.twig' %}

{% block title %}
	{{ 'clients.title' | trans }}
{% endblock %}

{% block body %}
<div class="mx-auto max-w-360 px-10 mb-20">
    <div class="mx-auto max-w-180 flex flex-col gap-4">
        <h1 class="text-black text-2xl font-bold">{{ 'clients.title' | trans }}</h1>
        <p class="text-content">{{ 'clients.description' | trans | raw }}</p>

        <div class="grid grid-cols-3 gap-6">
            {% for client in oauth_clients %}
                <a href="{{ client.baseUri }}" class="block h-full">
                    <div class="h-full bg-white border border-grey rounded-2xl p-4 shadow-sm flex items-center">
                        <div class="flex flex-col gap-4">
                            <img
                                class="max-h-16 h-auto grayscale"
                                src="/oauth2/clients/{{ client.identifier }}.png"
                                alt="{{ client.name }}"
                            >
                            <div>
                                <span class="text-content text-xs">Name</span>
                                <p>{{ client.name }}</p>
                            </div>
                            <div>
                                <span class="text-content text-xs">Site</span>
                                <p class="text-sm">{{ client.baseUri | replace({'https://' : '', 'https://www.' : '', 'http://' : '', '/' : ''}) }}</p>
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
